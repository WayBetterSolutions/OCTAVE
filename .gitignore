venv/
__pycache__/
*.pyc
backend/temp/
.claude/

# Build artifacts
dist/
build/
*.spec.bak

# Spotify credentials and cache
backend/settingsConfigure.json
backend/.spotify_token_cache

# Bundled tools (downloaded separately, not tracked in git)
tools/scrcpy/*.exe
tools/scrcpy/*.dll
tools/scrcpy/adb
tools/scrcpy/scrcpy
tools/scrcpy/scrcpy-server
tools/scrcpy/*.bat
tools/scrcpy/*.vbs
tools/scrcpy/*.png

# Generated protobuf files (regenerate with compile_protos.py)
backend/android_auto/proto/aap_protobuf/**/*_pb2.py

# Developer mode tools (completely isolated from main codebase)
# These files simulate OBD data for testing without a real car connection
dev/

# Test scripts
test_*.py
clear_dtc.py

# Old/extra virtual environments
venv_old_linux/

# Android Auto SSL certificates (generated locally)
backend/android_auto/certs/*.key
backend/android_auto/certs/*.crt
backend/android_auto/certs/*.pem

# Temp files (editor swap files, crash recovery, etc.)
*.tmp
*.tmp.*
*~
*.swp
*.swo
*.bak

# Performance profiling (dev tools)
profile_performance.py
profile_data_*.csv
PERFORMANCE_AUDIT.md
BLE_OBD_BRIDGE_REPORT.md
